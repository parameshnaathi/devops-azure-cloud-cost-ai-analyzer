# Copy this file to `.env` and fill in your own values. Never commit the real `.env` file.

# API key from https://platform.openai.com/api-keys, used by ai_analyzer.py
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model used for cost analysis. gpt-4o-mini is the cheapest capable option
# (fractions of a cent per analysis); use gpt-4o for higher-quality output.
OPENAI_MODEL=gpt-4o-mini

# Connection string for Azure Managed PostgreSQL, used by db.py.
# Example (Azure Database for PostgreSQL flexible server):
# postgresql://<user>:<[REDACTED_SQL_PASSWORD_1]>@<server-name>.postgres.database.azure.com:5432/<database>?sslmode=require
DATABASE_URL=postgresql://user:[REDACTED_SQL_PASSWORD_1]@localhost:5432/cloud_cost_detective

# Secret used to sign/verify JWTs issued by auth.py. Generate your own random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JWT_SECRET_KEY=change-this-to-a-long-random-string
